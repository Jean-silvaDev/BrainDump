# Auto-detect text files and perform LF normalization on commit
* text=auto

# Source code explicitly using LF
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.slnx text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
